# Public Shopify storefront domain. Used by app/api/shop/route.ts.
SHOPIFY_STORE_DOMAIN=shop.example.com

# Shopify Storefront API token. Used server-side by app/api/shop/route.ts.
# Set the real value as a local environment variable or Cloudflare Worker secret.
SHOPIFY_STOREFRONT_TOKEN=replace-with-storefront-token

# Shopify Dev Dashboard app credentials for the approval-gated draft-product adapter.
# Both values are Worker secrets. The adapter exchanges them for a short-lived Admin API token.
SHOPIFY_ADMIN_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_ADMIN_CLIENT_SECRET=replace-with-shopify-client-secret

# YouTube Data API key. Used server-side by app/api/youtube/route.ts.
# Set the real value as a local environment variable or Cloudflare Worker secret.
YOUTUBE_API_KEY=replace-with-youtube-api-key
