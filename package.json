{
  "name": "reallybadsecurity-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build-editorial-bundle.mjs && next build",
    "ci": "npm run test && npm run typecheck && npm run lint && npm run validate:editorial && npm run build",
    "deploy": "npm run deploy:production",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env=\"\"",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:goods": "vitest run app/modules/goods",
    "typecheck": "tsc --noEmit",
    "validate:editorial": "node scripts/validate-editorial.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
